import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression

data = {
    'floor_area': [500, 800, 1000, 1200, 1500, 1800],
    'rooms': [1, 2, 2, 3, 3, 4],
    'location_score': [3, 5, 4, 5, 2, 5],
    'rent': [8000, 15000, 16000, 22000, 20000, 30000]
}

df = pd.DataFrame(data)
X = df[['floor_area', 'rooms', 'location_score']]
y = df['rent']

model = LinearRegression()
model.fit(X, y)

sample = [[1300, 3, 4]]
predicted_rent = model.predict(sample)[0]

print(f"Predicted Rent for a {sample[0][0]} sq ft apartment with "
      f"{sample[0][1]} rooms and location score {sample[0][2]} "
      f"is approximately Rs. {predicted_rent:.2f}")

predicted_all = model.predict(X)

plt.figure(figsize=(7, 5))
plt.scatter(df['floor_area'], y, color='blue', label='Actual Rent')
plt.scatter(df['floor_area'], predicted_all, color='red', label='Predicted Rent')
plt.scatter(sample[0][0], predicted_rent, color='green', s=120, marker='*',
            label='New Prediction')
plt.xlabel('Floor Area (sq ft)')
plt.ylabel('Rent')
plt.title('Actual vs Predicted Rent')
plt.legend()
plt.grid(True)
plt.show()

