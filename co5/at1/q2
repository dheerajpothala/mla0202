import numpy as np
import random

random.seed(42)
np.random.seed(42)

NUM_ADS = 5
NUM_INTERACTIONS = 10000
EPSILON = 0.1

TRUE_CTR = [0.05, 0.12, 0.08, 0.20, 0.15]
BEST_AD = int(np.argmax(TRUE_CTR))
BEST_CTR = max(TRUE_CTR)


def epsilon_greedy_bandit():
    counts = np.zeros(NUM_ADS)
    estimated_ctr = np.zeros(NUM_ADS)
    total_reward = 0
    cumulative_regret = 0
    regret_history = []
    selection_counts = np.zeros(NUM_ADS)

    for t in range(1, NUM_INTERACTIONS + 1):
        if random.random() < EPSILON:
            ad = random.randrange(NUM_ADS)
        else:
            ad = int(np.argmax(estimated_ctr))

        click = 1 if random.random() < TRUE_CTR[ad] else 0
        total_reward += click
        counts[ad] += 1
        selection_counts[ad] += 1
        estimated_ctr[ad] += (click - estimated_ctr[ad]) / counts[ad]

        cumulative_regret += BEST_CTR - TRUE_CTR[ad]
        regret_history.append(cumulative_regret)

    return estimated_ctr, selection_counts, total_reward, cumulative_regret, regret_history


def ucb_bandit():
    counts = np.zeros(NUM_ADS)
    estimated_ctr = np.zeros(NUM_ADS)
    total_reward = 0
    cumulative_regret = 0
    regret_history = []

    for t in range(1, NUM_INTERACTIONS + 1):
        if t <= NUM_ADS:
            ad = t - 1
        else:
            ucb_values = estimated_ctr + np.sqrt(2 * np.log(t) / counts)
            ad = int(np.argmax(ucb_values))

        click = 1 if random.random() < TRUE_CTR[ad] else 0
        total_reward += click
        counts[ad] += 1
        estimated_ctr[ad] += (click - estimated_ctr[ad]) / counts[ad]

        cumulative_regret += BEST_CTR - TRUE_CTR[ad]
        regret_history.append(cumulative_regret)

    return estimated_ctr, counts, total_reward, cumulative_regret, regret_history


eg_ctr, eg_counts, eg_reward, eg_regret, eg_hist = epsilon_greedy_bandit()
ucb_ctr, ucb_counts, ucb_reward, ucb_regret, ucb_hist = ucb_bandit()

