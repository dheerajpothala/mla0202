print("Question 3: Sampling Strategy for ML Model Development")
print("=" * 60)
print(f"Population size            : {POPULATION_SIZE:,}")
print(f"Population distribution %  : {population_dist}")
print(f"Statistically required n   : {stat_sample_size:,} (95% confidence, 5% margin)")
print(f"RAM-feasible max sample    : {memory_cap_sample_size:,} records (8 GB limit)")
print(f"Final chosen sample size   : {final_sample_size:,}")
print("-" * 60)
print("Simple Random Sampling result:")
print(f"  Distribution %: {srs_dist}")
print("-" * 60)
print("Stratified Sampling result:")
print(f"  Distribution %: {strat_dist}")
print("-" * 60)
print(f"Approx. VC dimension budget for sample size: {vc_dimension_estimate}")
print("Recommended method: Stratified Sampling")
print("Reason: preserves population proportions across risk categories,")
print("reducing sampling bias while satisfying memory and confidence constraints.")
