import numpy as np
import random

GRID_SIZE = 6
ACTIONS = ['UP', 'DOWN', 'LEFT', 'RIGHT']
ACTION_DELTA = {'UP': (-1, 0), 'DOWN': (1, 0), 'LEFT': (0, -1), 'RIGHT': (0, 1)}

OBSTACLES = {(1, 1), (1, 2), (2, 4), (3, 1), (4, 3)}
START = (0, 0)
GOAL = (5, 5)
MAX_MOVES = 25
BATTERY_CAPACITY = 30

STEP_PENALTY = -1
OBSTACLE_PENALTY = -20
GOAL_REWARD = 50

GAMMA = 0.9
THETA = 1e-4
SLIP_PROB = 0.1
EPSILON = 0.2


def is_valid(state):
    r, c = state
    return 0 <= r < GRID_SIZE and 0 <= c < GRID_SIZE and state not in OBSTACLES


def next_state(state, action):
    dr, dc = ACTION_DELTA[action]
    new_state = (state[0] + dr, state[1] + dc)
    return new_state if is_valid(new_state) else state


def get_reward(state):
    if state == GOAL:
        return GOAL_REWARD
    if state in OBSTACLES:
        return OBSTACLE_PENALTY
    return STEP_PENALTY


def transition_probs(state, action):
    outcomes = {}
    intended = next_state(state, action)
    outcomes[intended] = outcomes.get(intended, 0) + (1 - SLIP_PROB)
    other_actions = [a for a in ACTIONS if a != action]
    for a in other_actions:
        ns = next_state(state, a)
        outcomes[ns] = outcomes.get(ns, 0) + (SLIP_PROB / len(other_actions))
    return outcomes


def value_iteration():
    V = np.zeros((GRID_SIZE, GRID_SIZE))
    policy = {}

    while True:
        delta = 0
        for r in range(GRID_SIZE):
            for c in range(GRID_SIZE):
                state = (r, c)
                if state in OBSTACLES or state == GOAL:
                    continue
                v_old = V[r][c]
                action_values = []
                for action in ACTIONS:
                    outcomes = transition_probs(state, action)
                    value = 0
                    for ns, prob in outcomes.items():
                        value += prob * (get_reward(ns) + GAMMA * V[ns[0]][ns[1]])
                    action_values.append(value)
                best_value = max(action_values)
                V[r][c] = best_value
                policy[state] = ACTIONS[int(np.argmax(action_values))]
                delta = max(delta, abs(v_old - best_value))
        if delta < THETA:
            break

    return V, policy


def epsilon_greedy_action(state, policy):
    if random.random() < EPSILON:
        return random.choice(ACTIONS)
    return policy.get(state, random.choice(ACTIONS))


def simulate_episode(policy):
    state = START
    battery = BATTERY_CAPACITY
    path = [state]

    for move in range(1, MAX_MOVES + 1):
        if state == GOAL:
            break
        action = epsilon_greedy_action(state, policy)
        outcomes = transition_probs(state, action)
        states, probs = zip(*outcomes.items())
        state = random.choices(states, weights=probs, k=1)[0]
        battery -= 1
        path.append(state)
        if battery <= 0:
            break

    reached_goal = state == GOAL
    return path, reached_goal, BATTERY_CAPACITY - battery


V, policy = value_iteration()
path, reached_goal, battery_used = simulate_episode(policy)

