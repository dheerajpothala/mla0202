import matplotlib.pyplot as plt
import networkx as nx

student_name = "Dheeraj Krushna"
reg_no = "192525230"

comparison = {
    "Graph Structure": ("Bayesian Network: Directed Acyclic Graph (DAG), edges show causal/parent-child relations", "MRF: Undirected graph, edges show symmetric correlations"),
    "Conditional Independence": ("BN: Uses d-separation based on directed edges", "MRF: Uses graph separation (Markov blanket) in undirected graph"),
    "Inference Process": ("BN: Belief propagation, variable elimination exploiting causal structure", "MRF: Uses potential functions, Gibbs sampling, loopy belief propagation"),
    "Uncertainty Handling": ("BN: Naturally models causal uncertainty in disease-symptom relations", "MRF: Models symmetric uncertainty, useful for spatial/contextual dependencies"),
    "Computational Complexity": ("BN: Efficient when causal structure is sparse", "MRF: Partition function computation is expensive"),
    "Real World Applicability": ("BN: Well suited for diagnosis systems with clear cause-effect", "MRF: Better suited when relationships are non-causal/symmetric"),
    "Conclusion": ("Bayesian Networks are more appropriate for disease diagnosis due to natural causal representation between diseases and symptoms",)
}

scores = {
    "Interpretability": (5, 3),
    "Inference Speed": (4, 2),
    "Handles Symmetric Deps": (2, 5),
    "Scalability": (4, 3),
    "Suitability (Diagnosis)": (5, 3)
}

def print_comparison(title, data):
    print(title)
    print("-" * len(title))
    for key, values in data.items():
        print(f"{key}:")
        for v in values:
            print(f"  - {v}")

def draw_bn():
    g = nx.DiGraph()
    g.add_edges_from([("Disease A", "Symptom 1"), ("Disease A", "Symptom 2"), ("Disease B", "Symptom 2"), ("Disease B", "Symptom 3")])
    pos = nx.spring_layout(g, seed=1)
    nx.draw(g, pos, with_labels=True, node_color="#a6cee3", node_size=1800, arrows=True, font_size=8)
    plt.title("Bayesian Network (Directed)")

def draw_mrf():
    g = nx.Graph()
    g.add_edges_from([("Disease A", "Symptom 1"), ("Disease A", "Symptom 2"), ("Disease B", "Symptom 2"), ("Disease B", "Symptom 3")])
    pos = nx.spring_layout(g, seed=1)
    nx.draw(g, pos, with_labels=True, node_color="#fdbf6f", node_size=1800, font_size=8)
    plt.title("Markov Random Field (Undirected)")

def draw_scores():
    labels = list(scores.keys())
    bn_vals = [v[0] for v in scores.values()]
    mrf_vals = [v[1] for v in scores.values()]
    x = range(len(labels))
    width = 0.35
    plt.bar([i - width/2 for i in x], bn_vals, width, label="Bayesian Network", color="#1f78b4")
    plt.bar([i + width/2 for i in x], mrf_vals, width, label="MRF", color="#ff7f00")
    plt.xticks(list(x), labels, rotation=30, ha="right", fontsize=7)
    plt.ylabel("Score (1-5)")
    plt.title("Comparative Scoring")
    plt.legend()

print("Question 1: Bayesian Networks vs Markov Random Fields (Healthcare Diagnosis)")
print(f"Student Name: {student_name}")
print(f"Registration No: {reg_no}\n")
print_comparison("Comparative Analysis", comparison)

fig = plt.figure(figsize=(14, 5))
fig.suptitle(f"{student_name} / {reg_no} - Q1: BN vs MRF")

plt.subplot(1, 3, 1)
draw_bn()

plt.subplot(1, 3, 2)
draw_mrf()

plt.subplot(1, 3, 3)
draw_scores()

plt.tight_layout()
plt.savefig("question1_bn_vs_mrf.png", dpi=150)
plt.show()

# Output includes printed comparative analysis plus a saved graph image showing the BN structure, MRF structure, and a comparative score chart
