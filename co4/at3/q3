import matplotlib.pyplot as plt
import networkx as nx

student_name = "Dheeraj Krushna"
reg_no = "192525230"

comparison = {
    "Graph Representation": ("Bayesian Network: Directed graph representing causal dependencies", "MRF: Undirected graph representing symmetric dependencies"),
    "Dependency Modeling": ("BN: Explicit cause-effect between financial factors", "MRF: Joint correlation among transaction variables"),
    "Inference Techniques": ("BN: Exact/approximate inference using conditional probability tables", "MRF: Inference via potential functions and sampling methods"),
    "Learning Algorithms": ("BN: Parameter learning via MLE/Bayesian estimation", "MRF: Parameter learning via maximum pseudo-likelihood"),
    "Generalization Capability": ("BN: Good generalization with causal sparsity", "MRF: Good for capturing complex symmetric correlations"),
    "Computational Requirements": ("BN: Lower computational cost for sparse graphs", "MRF: Higher computational cost due to normalization constant"),
    "Suitability for Financial Risk": ("BN: Suitable due to interpretable causal risk factors", "MRF: Suitable for correlated transaction patterns"),
    "Conclusion": ("Bayesian Networks are more effective for financial risk prediction due to interpretability and causal reasoning",)
}

scores = {
    "Interpretability": (5, 3),
    "Inference Speed": (4, 2),
    "Correlation Modeling": (3, 5),
    "Computational Cost": (4, 2),
    "Suitability (Risk Prediction)": (5, 3)
}

def print_comparison(title, data):
    print(title)
    print("-" * len(title))
    for key, values in data.items():
        print(f"{key}:")
        for v in values:
            print(f"  - {v}")

def draw_directed():
    g = nx.DiGraph()
    g.add_edges_from([("Income", "Risk"), ("Credit History", "Risk"), ("Transaction Pattern", "Risk"), ("Risk", "Default Prediction")])
    pos = nx.spring_layout(g, seed=2)
    nx.draw(g, pos, with_labels=True, node_color="#a6cee3", node_size=1800, arrows=True, font_size=7)
    plt.title("Directed Graphical Model (Bayesian Network)")

def draw_undirected():
    g = nx.Graph()
    g.add_edges_from([("Income", "Risk"), ("Credit History", "Risk"), ("Transaction Pattern", "Risk"), ("Risk", "Default Prediction")])
    pos = nx.spring_layout(g, seed=2)
    nx.draw(g, pos, with_labels=True, node_color="#fdbf6f", node_size=1800, font_size=7)
    plt.title("Undirected Graphical Model (MRF)")

def draw_scores():
    labels = list(scores.keys())
    bn_vals = [v[0] for v in scores.values()]
    mrf_vals = [v[1] for v in scores.values()]
    x = range(len(labels))
    width = 0.35
    plt.bar([i - width/2 for i in x], bn_vals, width, label="Bayesian Network", color="#1f78b4")
    plt.bar([i + width/2 for i in x], mrf_vals, width, label="MRF", color="#ff7f00")
    plt.xticks(list(x), labels, rotation=30, ha="right", fontsize=7)
    plt.ylabel("Score (1-5)")
    plt.title("Comparative Scoring")
    plt.legend()

print("Question 3: Directed Graphical Models vs Undirected Graphical Models (Financial Risk Prediction)")
print(f"Student Name: {student_name}")
print(f"Registration No: {reg_no}\n")
print_comparison("Comparative Analysis", comparison)

fig = plt.figure(figsize=(14, 5))
fig.suptitle(f"{student_name} / {reg_no} - Q3: Directed vs Undirected Graphical Models")

plt.subplot(1, 3, 1)
draw_directed()

plt.subplot(1, 3, 2)
draw_undirected()

plt.subplot(1, 3, 3)
draw_scores()

plt.tight_layout()
plt.savefig("question3_directed_vs_undirected.png", dpi=150)
plt.show()

# Output includes printed comparative analysis plus a saved graph image showing the directed model, undirected model, and a comparative score chart
